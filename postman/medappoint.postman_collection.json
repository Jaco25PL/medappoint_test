{
  "info": {
    "name": "MedAppoint - Reschedule Flow",
    "description": "API tests for the reschedule user story.\n\n**Authentication** is fully automatic: a collection-level pre-request script logs in with `app_email` / `app_password` from the environment, caches the JWT in a collection variable and only re-authenticates when the token is missing or about to expire (the login endpoint is rate limited - 429).\n\n**Required environment variables:** `api_base_url`, `app_email`, `app_password`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Automatic authentication: obtain and cache a JWT before any request that needs it.",
          "const isLoginRequest = pm.request.url.getPath().endsWith('/api/auth/login');",
          "// Requests inheriting the collection auth have no own auth object, so only skip explicit 'noauth'.",
          "const requiresAuth = !(pm.request.auth && pm.request.auth.type === 'noauth');",
          "",
          "if (!isLoginRequest && requiresAuth) {",
          "    const token = pm.collectionVariables.get('token');",
          "    const tokenExp = Number(pm.collectionVariables.get('token_exp') || 0);",
          "    const now = Math.floor(Date.now() / 1000);",
          "    const isValid = token && tokenExp - 60 > now; // renew 60s before expiry",
          "",
          "    if (!isValid) {",
          "        const baseUrl = pm.environment.get('api_base_url');",
          "        const email = pm.environment.get('app_email');",
          "        const password = pm.environment.get('app_password');",
          "        if (!baseUrl || !email || !password) {",
          "            throw new Error('Missing environment variables: api_base_url, app_email and app_password are required.');",
          "        }",
          "",
          "        pm.sendRequest({",
          "            url: `${baseUrl}/api/auth/login`,",
          "            method: 'POST',",
          "            header: { 'Content-Type': 'application/json' },",
          "            body: { mode: 'raw', raw: JSON.stringify({ email, password }) }",
          "        }, (err, res) => {",
          "            if (err || res.code !== 200) {",
          "                throw new Error(`Automatic login failed: ${err || res.code + ' ' + res.text()}`);",
          "            }",
          "            const newToken = res.json().token;",
          "            pm.collectionVariables.set('token', newToken);",
          "",
          "            // Read the expiry from the JWT payload; fall back to 5 minutes if it can't be decoded.",
          "            let exp = now + 300;",
          "            try {",
          "                const payload = JSON.parse(atob(newToken.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));",
          "                if (payload.exp) { exp = payload.exp; }",
          "            } catch (e) { /* keep fallback */ }",
          "            pm.collectionVariables.set('token_exp', String(exp));",
          "        });",
          "    }",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 - Auth",
      "item": [
        {
          "name": "Login - valid credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('Response contains a JWT token', () => {",
                  "    pm.expect(body.token).to.be.a('string');",
                  "    pm.expect(body.token.split('.')).to.have.lengthOf(3);",
                  "});",
                  "",
                  "pm.test('Response does not leak credentials', () => {",
                  "    pm.expect(pm.response.text()).to.not.include(pm.environment.get('app_password'));",
                  "});",
                  "",
                  "// Reuse this token (and its expiry) for the following requests, avoiding extra logins.",
                  "pm.collectionVariables.set('token', body.token);",
                  "let exp = Math.floor(Date.now() / 1000) + 300;",
                  "try {",
                  "    const payload = JSON.parse(atob(body.token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));",
                  "    if (payload.exp) { exp = payload.exp; }",
                  "} catch (e) { /* keep fallback */ }",
                  "pm.collectionVariables.set('token_exp', String(exp));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{app_email}}\",\n  \"password\": \"{{app_password}}\"\n}"
            },
            "url": "{{api_base_url}}/api/auth/login"
          }
        },
        {
          "name": "Get current user (auth check)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "const user = pm.response.json();",
                  "pm.test('Returns the authenticated patient', () => {",
                  "    pm.expect(user.email).to.eql(pm.environment.get('app_email'));",
                  "    pm.expect(user.id).to.be.a('number');",
                  "});",
                  "",
                  "pm.collectionVariables.set('patient_id', user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{api_base_url}}/api/users/me"
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "token", "value": "" },
    { "key": "token_exp", "value": "" },
    { "key": "patient_id", "value": "" }
  ]
}
